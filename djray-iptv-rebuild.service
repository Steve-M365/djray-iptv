[Unit]
Description=DJRay IPTV daily playlist rebuild
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Adjust to wherever you cloned the repository (default: ~/scripts/djray-iptv).
WorkingDirectory=%h/scripts/djray-iptv
ExecStart=%h/scripts/djray-iptv/rebuild.sh
StandardOutput=append:%h/scripts/djray-iptv/rebuild.log
StandardError=append:%h/scripts/djray-iptv/rebuild.log

[Install]
WantedBy=multi-user.target